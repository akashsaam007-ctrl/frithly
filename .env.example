# ---------- Shared (Vercel web app AND the VPS worker) ----------
# Postgres (Supabase or Neon). Use the direct/session connection string, not the transaction pooler,
# because the job queue (pg-boss) needs session features.
DATABASE_URL=postgres://user:pass@host:5432/frithly
# 32 random bytes, base64:  openssl rand -base64 32   (same value on web and worker, never change it)
ENCRYPTION_KEY=
APP_URL=https://app.frithly.com
ANTHROPIC_API_KEY=
# Optional model overrides
# CLAUDE_FAST_MODEL=claude-haiku-5-5
# CLAUDE_WRITER_MODEL=claude-sonnet-5-5

# Microsoft 365 mailboxes (Azure app registration, multi-tenant, redirect: $APP_URL/api/mailbox/microsoft/callback)
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---------- Web app only (Vercel) ----------
# System email for sign-in codes (Resend SMTP, Postmark, SES...). Leave SYSTEM_SMTP_HOST empty in dev to print codes to the log.
SYSTEM_SMTP_HOST=smtp.resend.com
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=resend
SYSTEM_SMTP_PASS=
SYSTEM_FROM=Frithly <hello@frithly.com>

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
# Coupon: 20% off, duration "once"
STRIPE_COUPON_FIRST_MONTH=
STRIPE_PRICE_ADDON_OPPORTUNITIES=
STRIPE_PRICE_ADDON_MAILBOX=
STRIPE_PRICE_ADDON_SEAT=
STRIPE_PRICE_ADDON_PHONES=
STRIPE_AUTOMATIC_TAX=0

# ---------- Worker only ----------
# How emails are found and checked:
#   smtp     = in-house permutations + mail-server checks (needs outbound port 25: Hetzner/OVH after unblock)
#   prospeo  = Prospeo finds and verifies (no port 25; use on Google Cloud, AWS, Azure). ~1 credit per email found.
EMAIL_FINDER=smtp
# Hostname with matching A and PTR (reverse DNS) records pointing at the VPS IP
VERIFY_HELO=verify.frithly.com
# Address on a domain you own; never your main sending domain
VERIFY_FROM=verify@frithly-mail.com
SCANNER_USER_AGENT=FrithlyBot/1.0 (+https://frithly.com/bot)
SCAN_BATCH=60
SCAN_CONCURRENCY=4
ENRICH_CONCURRENCY=3
# Send to catch-all addresses that could not be confirmed (0 = no, safer for deliverability)
ALLOW_CATCH_ALL=0
# GitHub token (no scopes needed) raises the API limit from 60 to 5,000 requests an hour
GITHUB_TOKEN=
# Optional paid fallbacks
PROSPEO_API_KEY=
THEIRSTACK_API_KEY=
