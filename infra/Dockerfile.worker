FROM node:22-slim
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker
RUN pnpm install --frozen-lockfile --filter @frithly/worker... --filter @frithly/db...
ENV NODE_ENV=production
# Apply database migrations, then start the worker.
CMD ["sh", "-c", "pnpm --filter @frithly/db migrate && pnpm --filter @frithly/worker start"]
